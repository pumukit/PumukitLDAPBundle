<div class="modal-header">
    <h4 class="modal-title">{% trans %}new person from LDAP{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{% trans %}Cancel{% endtrans %}"></button>
</div>
<div class="modal-body"
     data-controller="ldap--person-picker"
     data-ldap--person-picker-autocomplete-url-value="{{ path('pumukit_ldap_person_autocomplete') }}"
     data-ldap--person-picker-link-url-value="{{ path('pumukit_ldap_person_link', {'mmId': mm.id, 'roleId': role.id}) }}"
     data-ldap--person-picker-target-value="#{{ role.id }}_person_mms{{ template }}"
     data-ldap--person-picker-preview-value="{{ template != '_template' ? path('pumukitnewadmin_mms_show', {'id': mm.id}) : '' }}"
     data-ldap--person-picker-modal-value="#myModal"
     data-ldap--person-picker-messages-value="{{ {linked: 'Person successfully associated to Multimedia Object'|trans ~ ' \'' ~ mm.getTitle() ~ '\' ' ~ 'with role'|trans ~ ' \'' ~ role.getName() ~ '\'', selectFirst: 'Select before a person'|trans}|json_encode }}">
    <p>{% trans %}Write the email login of the person you would like to add from the LDAP server. A pull-down menu will be shown, where you can select and use the person data.{% endtrans %}</p>
    <div class="mb-3">
        <label for="ldap_login" class="form-label">{% trans %}Login{% endtrans %}:</label>
        <input type="text" id="ldap_login" class="form-control" data-ldap--person-picker-target="login" data-action="input->ldap--person-picker#clear"/>
        <input type="hidden" id="ldap_person_mail" value="" data-ldap--person-picker-target="mail"/>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
        <button type="button" class="btn btn-primary" data-action="click->ldap--person-picker#use">{% trans %}Use{% endtrans %}</button>
    </div>
</div>
